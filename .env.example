# Docker 배포 설정 (이 파일을 복사해서 .env 로 만드세요)
# 이 저장소는 이미지를 배포하지 않습니다. docker-compose.yml 의 artex 서비스는
# 로컬 Dockerfile 로 직접 빌드하며(build:), 아래 ARTEX_IMAGE 가 그 이미지의 태그입니다.
# 상류 이미지 autumn27/artex 는 Docker Hub 에서 사라져 pull 로는 기동할 수 없습니다.
# 빌드 절차는 README "한국어판 이미지를 직접 빌드하기" 를 보십시오.
ARTEX_IMAGE=artex-ko:local

# UI 언어. ko = 한국어판(기본), zh = 중국어 UI.
# 바꾼 뒤에는 ./build-image.sh 를 실행하십시오(언어가 바뀐 것을 감지해 다시 빌드합니다):
#   ./build-image.sh --locale zh        # 또는 아래 값을 zh 로 바꾸고 ./build-image.sh
# Dockerfile 은 컨테이너 안에서 프런트엔드를 컴파일하지 않으므로, `NEXT_PUBLIC_LOCALE=zh
# docker compose up -d --build` 는 동작하지 않습니다(복사되는 바이너리가 그대로입니다).
# 주의: 바뀌는 것은 "화면 문구"뿐입니다. 에이전트가 쓰는 리포트·요약·채팅 응답의 언어는
# Go 코드(agent/prompt.go 의 langDirective)가 정하며 이 값과 무관하게 한국어입니다.
NEXT_PUBLIC_LOCALE=ko
# 서버 런타임 언어. 화면 문구뿐 아니라 **서버가 DB 에 시드하는 표시 이름**(reporter 등
# 내장 agent 이름)의 언어를 정한다. 웹 UI 의 locale 은 빌드 시점에 HTML 에 박혀 서버가
# 알 수 없어 별도로 받는다. ./build-image.sh 를 쓰면 --locale 값이 여기로 자동 전달되므로
# 직접 맞출 필요가 없다. 둘을 손으로 다르게 두면 중국어 UI 에 한국어 agent 이름이 섞인다.
ARTEX_LOCALE=ko

POSTGRES_USER=artex
# ⚠️ 이 비밀번호는 PostgreSQL 볼륨이 처음 만들어질 때 딱 한 번만 쓰입니다. 스택을 이미
# 한 번 올린 뒤에 여기서 바꾸면 DB 쪽 비밀번호는 그대로라 artex 가 28P01 인증 실패로
# 재시작을 반복합니다(→ README "페이지가 안 열릴 때 (Docker)").
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (둘 중 하나만 또는 둘 다 입력하세요. 비워 두고 나중에 UI 에서 설정해도 됩니다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
