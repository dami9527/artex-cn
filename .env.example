# Docker 部署配置（复制此文件为 .env 后按需修改）
# 本仓库的 docker-compose.yml 默认用本地 Dockerfile 构建镜像（build:），不依赖任何预发布
# 镜像，下面的 ARTEX_IMAGE 就是构建出来的镜像标签。
# 上游镜像 autumn27/artex 已从 Docker Hub 下架，pull 不下来。
# 发布 CI 在打 v* 标签时也会把多架构镜像发到 ghcr.io/dami9527/artex-cn，但 compose 默认
# 仍走本地构建；构建步骤见 README 的「自行构建中文版镜像」一节。
ARTEX_IMAGE=artex-cn:local

# 界面语言。本仓库固定为简体中文，保留这两个变量只是为了让构建脚本显式传值。
# 改动后请执行 ./build-image.sh（它会检测到变化并重新构建）：
#   ./build-image.sh              # 用 .env 里的值构建并启动
#   ./build-image.sh --force      # 强制重新构建
# Dockerfile 不在容器内编译前端，所以 `NEXT_PUBLIC_LOCALE=zh docker compose up -d --build`
# 不会生效（复制进镜像的二进制还是旧的）。
NEXT_PUBLIC_LOCALE=zh
# 服务端运行时语言。它不只决定界面文案，还决定**服务端向数据库播种的显示名**
# （reporter 等内置 agent 名称）用哪种语言。界面 locale 在构建期就写进 HTML，
# 服务端看不到，所以单独接收一份。用 ./build-image.sh 时会自动传入同一个值，
# 不需要手改。
ARTEX_LOCALE=zh

POSTGRES_USER=artex
# ⚠️ 这个密码只在 PostgreSQL 数据卷第一次创建时生效一次。镜像栈已经起过之后再改这里，
# 数据库那边的密码并不会跟着变，artex 会因 28P01 认证失败反复重启
# （→ README「页面打不开时（Docker）」）。
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（两个只填一个或都填；也可以留空，稍后在界面里配置）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 首次设置保护（防止管理员账号被远程抢先占用）
# - 网页/API 端口默认只发布到宿主机的 127.0.0.1。确实需要从其他设备直接访问时，把它改成
#   ARTEX_BIND=0.0.0.0，但请先完成首次设置。
# - 第一次启动时日志里会打印一个随机设置令牌（docker compose logs artex），在 /setup 页面
#   填入该值才能创建管理员密码。若指定了 ARTEX_SETUP_TOKEN，则用它作为令牌且不再打印到日志。
# - 若指定了 ARTEX_ADMIN_PASSWORD，则跳过 /setup，直接用该值初始化（至少 8 个字符）。
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# 浏览器跨源（CORS）白名单（逗号分隔）。内置 UI 是同源，保持为空即可。
ARTEX_CORS_ORIGINS=

# 服务端默认输出语言（en、zh、es 之一）。留空即简体中文（zh）。
# - 它是 agent 报告、总结、对话回复以及服务端错误消息的默认值；在设置页面选定「显示语言」
#   后，以页面选择为准。
# - 服务端控制台日志只跟随这个值（与设置页面的选择无关）。
# - 网页界面文案的语言由构建期的 NEXT_PUBLIC_LOCALE 决定（本仓库固定 zh）。
ARTEX_LANG=
